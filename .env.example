# ---- Node ----
NODE_ENV=development

# ---- PostgreSQL (packages/core-database) ----
DATABASE_URL=postgres://postgres:postgres@localhost:5432/twoblog

# ---- Redis (cache / rate-limit / BullMQ backend) ----
REDIS_URL=redis://localhost:6379

# ---- MinIO / S3-compatible object storage (packages/core-media) ----
STORAGE_ENDPOINT=localhost
STORAGE_PORT=9000
STORAGE_USE_SSL=false
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=media

# ---- apps/api (NestJS) ----
API_PORT=4000
API_URL=http://localhost:4000

# Access/refresh token secrets — generate distinct high-entropy values per environment,
# never reuse across dev/staging/production, never commit real values.
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_TTL=30d

# Comma-separated list of origins allowed to call the API
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ---- apps/web (Next.js, public site) ----
WEB_PORT=3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
API_INTERNAL_URL=http://localhost:4000

# ---- apps/admin (Next.js, admin panel) ----
ADMIN_PORT=3001
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# ---- apps/worker (BullMQ) ----
WORKER_CONCURRENCY=5
