# ---- Node ----
NODE_ENV=development

# ---- PostgreSQL (packages/core-database) ----
DATABASE_URL=postgres://postgres:postgres@localhost:5432/twoblog

# Used only by infrastructure/docker-compose.yml to configure the postgres
# container itself — must match the user/password/db embedded in
# DATABASE_URL above (two representations of the same credential; compose
# has no way to parse a URL). Change all three away from these dev defaults
# before any real deployment — docker-compose.yml refuses to start postgres
# without POSTGRES_PASSWORD set.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=twoblog

# ---- Redis (cache / rate-limit / BullMQ backend) ----
REDIS_URL=redis://localhost:6379

# ---- MinIO / S3-compatible object storage (packages/core-media) ----
# STORAGE_ACCESS_KEY/STORAGE_SECRET_KEY double as MinIO's own root
# user/password in infrastructure/docker-compose.yml (single source of
# truth, no separate MINIO_ROOT_* pair to keep in sync) — change both away
# from these dev defaults before any real deployment. In Docker Compose,
# STORAGE_ENDPOINT must be the service name (`minio`), not `localhost`.
STORAGE_ENDPOINT=localhost
STORAGE_PORT=9000
STORAGE_USE_SSL=false
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=media

# ---- apps/api (NestJS) ----
API_PORT=4000
API_URL=http://localhost:4000

# Access/refresh token secrets — generate distinct high-entropy values per environment,
# never reuse across dev/staging/production, never commit real values.
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_TTL=30d

# Comma-separated list of origins allowed to call the API
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Max size for a single media upload (packages/core-media). Large video/chunked
# upload is a separate future design, not this limit.
MEDIA_MAX_UPLOAD_MB=25

# ---- AI (packages/core-ai) ----
# "ollama" needs no API key and runs against a local server — the only
# provider actually exercised end to end in this repo's dev environment.
# Switching to "openai"/"gemini" requires the matching *_API_KEY below.
AI_PROVIDER=ollama
AI_OLLAMA_BASE_URL=http://localhost:11434
AI_OLLAMA_MODEL=llama3.2
OPENAI_API_KEY=
AI_OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
AI_GEMINI_MODEL=gemini-1.5-flash

# ---- apps/web (Next.js, public site) ----
WEB_PORT=3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
API_INTERNAL_URL=http://localhost:4000

# ---- apps/admin (Next.js, admin panel) ----
ADMIN_PORT=3001
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# ---- apps/worker (BullMQ) ----
WORKER_CONCURRENCY=5

# ---- packages/core-database seed script (optional, dev/first-deploy only) ----
# Bootstraps the first SUPER_ADMIN user. Leave unset to skip — there is no
# public registration endpoint, so without this the DB has no login until an
# existing admin creates one via the API.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
