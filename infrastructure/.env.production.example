# Production örneği — VPS'te `docker compose -f infrastructure/docker-compose.yml`
# ile ayağa kaldırılacak stack için. Repo kökündeki .env.example'dan farkı:
# servisler artık compose'un kendi network'ünde birbirini servis adıyla
# buluyor (localhost değil), ve public URL'ler gerçek VPS IP'sini kullanıyor.
#
# Bu dosyayı VPS'te repo kökünde `.env` olarak kaydedin (asla git'e commit
# etmeyin — .gitignore zaten `.env`'i kapsıyor). Aşağıdaki her <...> yer
# tutucusunu gerçek değerle değiştirin.

NODE_ENV=production

# ---- PostgreSQL ----
# POSTGRES_USER/PASSWORD/DB, docker-compose.yml'deki postgres container'ını
# yapılandırıyor — DATABASE_URL'deki kullanıcı/şifre/db adıyla BİREBİR
# aynı olmalı (ikisi aynı credential'ın iki temsili).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<openssl rand -hex 24>
POSTGRES_DB=twoblog
DATABASE_URL=postgres://postgres:<yukarıdakiyle-aynı-şifre>@postgres:5432/twoblog

# VPS'te zaten kendi (Docker dışı) postgres'i 5432'de çalışıyorsa, bu
# container'ın host'a açılan portunu değiştirin — container'ın kendi içi
# her zaman 5432 kalır (DATABASE_URL yukarıda hâlâ postgres:5432 kullanır,
# değişmez), yalnızca dışarıdan psql ile bağlanmak isteyenler için host
# tarafı taşınır. Çakışma yoksa bu satırı tamamen silebilirsiniz.
# POSTGRES_HOST_PORT=5433

# ---- Redis ----
REDIS_URL=redis://redis:6379

# ---- MinIO / S3-compatible object storage ----
# STORAGE_ACCESS_KEY/SECRET_KEY aynı zamanda MinIO'nun root user/password'ü
# (docker-compose.yml'de tek kaynak). STORAGE_ENDPOINT compose network'ünde
# servis adı olmalı, "localhost" değil.
STORAGE_ENDPOINT=minio
STORAGE_PORT=9000
STORAGE_USE_SSL=false
STORAGE_ACCESS_KEY=<en az 8 karakter>
STORAGE_SECRET_KEY=<openssl rand -hex 24>
STORAGE_BUCKET=media

# ---- apps/api ----
API_PORT=4000
API_URL=http://<VPS_IP>:8080

# `openssl rand -hex 32` ile üretin, ikisi birbirinden farklı olmalı.
JWT_ACCESS_SECRET=<openssl rand -hex 32>
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=<openssl rand -hex 32>
JWT_REFRESH_TTL=30d

# Tarayıcının doğrudan çağırabileceği origin'ler (apps/web şu an tamamen
# server-side render olduğu için pratikte kullanılmıyor, ama admin/web'in
# kendi origin'lerini yine de doğru set edin).
CORS_ORIGINS=http://<VPS_IP>,http://<VPS_IP>:8081

MEDIA_MAX_UPLOAD_MB=25

# ---- AI ----
AI_PROVIDER=ollama
AI_OLLAMA_BASE_URL=http://host.docker.internal:11434
AI_OLLAMA_MODEL=llama3.2
OPENAI_API_KEY=
AI_OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
AI_GEMINI_MODEL=gemini-1.5-flash

# ---- apps/web ----
# Next.js build-time'da bu değeri bundle'a gömüyor (sitemap.xml/robots.txt/
# OpenGraph doğru URL'leri üretsin diye) — docker-compose.yml'nin web
# servisi bunu bir build arg olarak da geçiyor, `docker compose build`
# çalıştırılmadan önce .env'de doğru olmalı.
#
# VPS'te port 80 zaten başka bir şey tarafından kullanılıyorsa (paylaşımlı
# bir sunucuda başka bir proje gibi), CADDY_WEB_PORT'u boş bir porta ayarlayın
# (örn. 8082) VE NEXT_PUBLIC_SITE_URL/CORS_ORIGINS'e de aynı portu ekleyin —
# ikisi senkron olmalı, biri Caddy'nin dinlediği host portu, diğeri
# tarayıcının/browser'ın gerçekte gideceği URL.
# CADDY_WEB_PORT=8082
WEB_PORT=3000
NEXT_PUBLIC_SITE_URL=http://<VPS_IP>
API_INTERNAL_URL=http://api:4000

# ---- apps/admin ----
ADMIN_PORT=3001
NEXT_PUBLIC_ADMIN_URL=http://<VPS_IP>:8081

# ---- apps/worker ----
WORKER_CONCURRENCY=5

# ---- İlk deploy sonrası tek seferlik seed ----
# `docker compose exec api pnpm --filter @2blog/core-database seed` ile
# çalıştırılır; sonrasında burada bırakmanın bir zararı yok (script
# idempotent) ama isterseniz temizleyebilirsiniz.
SEED_ADMIN_EMAIL=<gerçek admin email>
SEED_ADMIN_PASSWORD=<güçlü bir şifre>
